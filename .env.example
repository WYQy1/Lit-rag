# 环境变量示例文件
#
# 用法：
#   1. 复制本文件为 .env      ->  copy .env.example .env
#   2. 把下面的占位符替换成你自己的真实 Key
#
# 安全提醒：
#   .env 已被 .gitignore 忽略，**永远不要**把它提交到 Git 仓库。
#   本文件（.env.example）只放占位符，可以安全提交。

# ============================================================
# 对话模型（用于 hello-llm 脚本；后续做「带引用的问答」也会用到）
# ============================================================
# DeepSeek 开放平台：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-在此填入你的真实Key


# ============================================================
# 向量化（RAG 检索必需）
# ============================================================
#
# ⚠️ 重要：DeepSeek 只提供对话模型，**不提供 embeddings 接口**。
#    所以要跑真实检索，必须单独配置一家向量化服务商。
#
# 可选方案（按性价比排序）：
#   1. 硅基流动 SiliconFlow —— 模型 BAAI/bge-m3，有免费额度，中文效果好
#      base_url = https://api.siliconflow.cn/v1
#   2. 智谱 AI —— 模型 embedding-3
#      base_url = https://open.bigmodel.cn/api/paas/v4
#   3. 阿里云百炼 —— 模型 text-embedding-v4
#      base_url = https://dashscope.aliyuncs.com/compatible-mode/v1
#   4. OpenAI —— 模型 text-embedding-3-small
#      base_url = https://api.openai.com/v1
#
# 不配置也能跑：LIT_RAG_EMBED_PROVIDER 默认就是 offline，
# 使用内置的哈希向量化器，用于验证链路和跑测试，但检索质量很低。

# 向量化后端：offline（离线，免费，质量低） | openai（真实模型）
LIT_RAG_EMBED_PROVIDER=offline

# 模型名，例如 BAAI/bge-m3
LIT_RAG_EMBED_MODEL=BAAI/bge-m3

# 服务地址（走 openai 后端时必填）
LIT_RAG_EMBED_BASE_URL=https://api.siliconflow.cn/v1

# 向量化服务的 Key（与 DEEPSEEK_API_KEY 不是同一个）
LIT_RAG_EMBED_API_KEY=sk-在此填入向量化服务的Key

# 单次请求的文本条数
LIT_RAG_EMBED_BATCH_SIZE=32


# ============================================================
# 切分参数（可选，不填则用默认值）
# ============================================================

# 单个 chunk 的字符数上限（英文约 4 字符/token，中文约 1 字符/token）
LIT_RAG_CHUNK_SIZE=800

# 相邻 chunk 的重叠字符数，必须小于 CHUNK_SIZE
LIT_RAG_CHUNK_OVERLAP=120

# 低于此长度的碎片会尽量并回前一块（不跨章节合并）
LIT_RAG_MIN_CHUNK_SIZE=80

# PDF 解析后端：auto | pymupdf | pypdf
LIT_RAG_PDF_BACKEND=auto

# 是否在切分前裁掉参考文献列表：true | false
LIT_RAG_DROP_REFERENCES=false


# ============================================================
# 检索参数（可选）
# ============================================================

# 默认返回条数
LIT_RAG_TOP_K=5
